<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         alignment="TOP_CENTER" spacing="12" stylesheets="@../../css/desktop-seat-map.css">
    <Label text="MÀN HÌNH" maxWidth="Infinity" styleClass="screen"/>
    <GridPane fx:id="seats" alignment="CENTER" hgap="5" vgap="5"/>
    <HBox alignment="CENTER" spacing="18">
        <HBox alignment="CENTER_LEFT" spacing="5">
            <Region styleClass="legend-swatch, legend-free"/>
            <Label text="Ghế trống"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="5">
            <Region styleClass="legend-swatch, legend-selected"/>
            <Label text="Ghế đang chọn"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="5">
            <Region styleClass="legend-swatch, legend-sold"/>
            <Label text="Ghế đã bán"/>
        </HBox>
    </HBox>
</fx:root>
