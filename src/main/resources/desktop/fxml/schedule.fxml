<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="12" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.ScheduleController">
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab fx:id="tabRooms" text="Quản lý phòng chiếu">
                <fx:include source="room-tab.fxml" fx:id="roomTab"/>
            </Tab>
            <Tab fx:id="tabShowtimes" text="Quản lý suất chiếu">
                <fx:include source="showtime-tab.fxml" fx:id="showtimeTab"/>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
