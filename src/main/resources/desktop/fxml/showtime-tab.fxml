<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox fx:id="root" spacing="20" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.ShowtimeController">

    <!-- Left panel: Filter bar, TableView, and Pagination for showtimes -->
    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <!-- Filter Bar -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Lọc:" styleClass="field-label"/>
            <ComboBox fx:id="cbFilterMovie" promptText="Tất cả phim" prefWidth="180"/>
            <ComboBox fx:id="cbFilterRoom" promptText="Tất cả phòng" prefWidth="140"/>
            <DatePicker fx:id="dpFilterDate" promptText="Ngày chiếu" prefWidth="140"/>
            <Button fx:id="btnFilter" text="Lọc" onAction="#onFilter" styleClass="button"/>
            <Button fx:id="btnResetFilter" text="Đặt lại" onAction="#onResetFilter" styleClass="button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRefresh" text="Làm mới" onAction="#reload" styleClass="button"/>
        </HBox>

        <!-- TableView for Showtimes -->
        <TableView fx:id="tableShowtimes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="Mã" prefWidth="50"/>
                <TableColumn fx:id="colMovie" text="Tên phim" prefWidth="180"/>
                <TableColumn fx:id="colRoom" text="Phòng chiếu" prefWidth="110"/>
                <TableColumn fx:id="colStart" text="Bắt đầu" prefWidth="130"/>
                <TableColumn fx:id="colEnd" text="Kết thúc" prefWidth="130"/>
                <TableColumn fx:id="colPrice" text="Giá vé" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Pagination Controls -->
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnPrevPage" text="&lt; Trang trước" onAction="#onPrevPage" styleClass="button"/>
            <Label fx:id="lblPageInfo" text="Trang 1 / 1" styleClass="text-muted"/>
            <Button fx:id="btnNextPage" text="Trang sau &gt;" onAction="#onNextPage" styleClass="button"/>
        </HBox>
    </VBox>

    <!-- Right panel: Showtime input form -->
    <VBox fx:id="formBox" spacing="12" styleClass="kpi-card" prefWidth="380" minWidth="340">
        <Label fx:id="lblFormTitle" text="Thêm suất chiếu mới" styleClass="section-title"/>

        <VBox spacing="4">
            <Label text="Chọn phim (*)" styleClass="field-label"/>
            <ComboBox fx:id="cbMovie" maxWidth="Infinity" promptText="Chọn phim chiếu"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Phòng chiếu (*)" styleClass="field-label"/>
            <ComboBox fx:id="cbRoom" maxWidth="Infinity" promptText="Chọn phòng chiếu"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Ngày chiếu (*)" styleClass="field-label"/>
            <DatePicker fx:id="dpDate" maxWidth="Infinity" promptText="Chọn ngày chiếu"/>
        </VBox>

        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Giờ bắt đầu (0–23)" styleClass="field-label"/>
                <Spinner fx:id="spHour" editable="true" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Phút bắt đầu (0–55)" styleClass="field-label"/>
                <Spinner fx:id="spMinute" editable="true" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label text="Giá vé (VNĐ, tối thiểu 1.000đ) (*)" styleClass="field-label"/>
            <TextField fx:id="tfPrice" promptText="VD: 75000"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Giờ kết thúc dự kiến:" styleClass="field-label"/>
            <Label fx:id="lblEnd" text="Kết thúc (gợi ý): -" styleClass="kpi-value, kpi-showing"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Form Action Buttons -->
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="btnNew" text="Làm lại" onAction="#onNew" styleClass="button"/>
            <Button fx:id="btnDelete" text="Xoá" onAction="#onDelete" styleClass="button"/>
            <Button fx:id="btnSave" text="Lưu suất chiếu" onAction="#onSave" styleClass="button, primary"/>
        </HBox>
    </VBox>

</HBox>
